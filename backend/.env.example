OPENAI_API_KEY="your-openai-api-key"
PINECONE_API_KEY="your-pinecone-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Required only when the key above is identity-linked (issued to a person
# rather than a workspace). Claude is unavailable until this is set.
ANTHROPIC_WORKSPACE_ID=""
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket"

# Optional. Caches the expensive half of the /sources reads across restarts and
# workers. Configured either way below; with neither set, the cache runs
# in-process instead — correct for a single worker, but lost on every reload.
#
# As parts, which is the better form for a password: nothing here needs
# percent-encoding, however much punctuation the password has.
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB="0"
# Set for a managed Redis that requires TLS (rediss://).
REDIS_TLS="false"
#
# Or as one URL, which wins over the parts when set. Percent-encode any of
# `@:/?#%` in the password.
REDIS_URL=""
